{
  "name": "dnu-opensource/pdf-manager",
  "description": "Công cụ sắp xếp, ghép, tách và xử lý tài liệu PDF trên trình duyệt - Đề tài 12 Phát triển phần mềm mã nguồn mở",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Đỗ Tiến Sơn",
    },
    {
      "name": "Đỗ Anh Duy",
    },
    {
      "name": "Vũ Văn Chiến",
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "setasign/fpdf": "^1.8",
    "setasign/fpdi": "^2.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "test": "phpunit tests",
    "seed-sample": "php sample_data/generate_test_pdfs.php"
  }
}
